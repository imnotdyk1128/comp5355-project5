  "generic": {
    "description": "Behaviour that is rare in ordinary pages and common in browser miners; used to rank candidates when no named platform matches.",
    "strong": [
      "CryptoNight",
      "cryptonight_light",
      "xmr-stak",
      "stratum",
      "jobId",
      "submitShare",
      "getWork",
      "exnoncE",
      "hashrate",
      "share_difficulty",
      "nicehash"
    ],
    "weak": [
      "new Worker(URL.createObjectURL",
      "WebAssembly.instantiateStreaming",
      "wss://",
      "atob(",
      "String.fromCharCode(",
      "document.write(unescape(",
      "eval(",
      "Function(\"return",
      "PHPSESSID=coinhive",
      "webassembly.instantiate",
      "emscripten"
    ],
    "worker_and_wasm_pattern": "dedicated worker that instantiates a wasm module and keeps one core busy",
    "note": "strong = mining-specific protocol or algorithm tokens; WebAssembly/emscripten are only weak signals because ordinary chart, codec and analytics scripts use them too"
  },
  "wallet_patterns": {
    "monero": "\\b4[0-9AB][123456789ABCDEFGHJKLMNPQRSTUVWXYZ]{93}\\b",
    "bitcoin_legacy": "\\b[13][a-km-zA-HJ-NP-Z1-9]{25,34}\\b",
    "bitcoin_bech32": "\\bbc1[qpstuvxyxz][acdefghjklmnpqrstuvwxyz024579]{38,58}\\b",
    "ethereum": "\\b0x[0-9a-fA-F]{40}\\b",
    "bytecoin": "\\b[abcdef0-9]{64}\\b"
  },
  "pool_url_patterns": [
    "ws:\\/\\/[\\w.-]+:\\d+",
    "wss:\\/\\/[\\w.-]+:\\d+",
    "wss:\\/\\/[\\w.-]+/(stratum|miner|mine|api)",
    "https?:\\/\\/[\\w.-]*(pool|mine|mining|stratum)[\\w.-]*"
