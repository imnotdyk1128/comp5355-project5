thread model as the miner,\n   but the page never opens a socket. Lets the analysis separate \"this page\n   burns CPU\" from \"this page burns CPU *and* talks to a mining pool\". */\n\nimportScripts('sha256.js');\nconst sha = self.__sha256;\n\nconst out = new Uint32Array(8);\nconst msg = new Uint8Array(36);\n\nlet hashes = 0;\nlet running = false;\nlet t0 = 0;\nlet slice = null;\nlet reporter = null;\n\nself.onmessage = (ev) => {\n  const m = ev.data;\n  if (m.cmd === 'start') {\n    running = true;\n    t0 = performance.now();\n    msg.set(sha.hexToBytes(m.seed || ('00'.repeat(32))), 0);\n    slice = setInterval(() => {\n      if (!running) return;\n      const end = performance.now() + 60;\n      do {\n        for (let i = 0; i < 4096; i++) {\n          const n = (hashes + i) >>> 0;\n          msg[32] = n & 255;\n          msg[33] = (n >>> 8) & 255;\n          msg[34] = (n >>> 16) & 255;\n          msg[35] = (n >>> 24) & 255;\n          sha.sha256Short(msg, out);\n        }\n        hashes += 4096;\n      } while (performance.now() < end);\n    }, 60);\n    reporter = setInterval(() => {\n      const elapsed = (performance.now() - t0) / 1000;\n      self.postMessage({ cmd: 'stats', hashes: hashes, hashrate: elapsed > 0 ? hashes / elapsed : 0 });\n    }, 1000);\n  } else if (m.cmd === 'stop') {\n    running = false;\n    clearInterval(slice);\n    clearInterval(reporter);\n  }\n};\n"},"headersSize":168,"bodySize":0,"redirectURL":"","_transferSize":168},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":-1,"receive":14.776},"_frameref":"frame@be709c3bf06deb3564ad0fc132249ac3","_monotonicTime":277763.106,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@fb01b8b93ea4ccdf97a1a0efe3beca2f","startedDateTime":"2026-10-26T09:11:03.580Z","time":11.404,"request":{"method":"GET","url":"http://127.0.0.1:8080/js/busy_worker.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","va