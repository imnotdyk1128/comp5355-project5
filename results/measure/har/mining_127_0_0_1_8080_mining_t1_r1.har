ime":1793005373232.3704,"opcode":1,"data":"{\"type\": \"ack\", \"ok\": true, \"shareId\": 24}"},{"type":"receive","time":1793005374445.1882,"opcode":1,"data":"{\"type\": \"job\", \"jobId\": 105, \"blob\": \"1ccb06f6a765d5f257f5604c0d7f9eda70e7589bd6b381c4b48a0fc6be22c7e7\", \"difficulty\": 22}"}]},{"pageref":"page@2efd93b6739e56e0b50a3251ecd96394","startedDateTime":"2026-10-26T09:02:21.801Z","time":2.647,"request":{"method":"GET","url":"http://127.0.0.1:8080/js/sha256.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Referer","value":"http://127.0.0.1:8080/js/miner_worker.js"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.0.0 Safari/537.36 Edg/156.0.0.0"}],"queryString":[],"headersSize":471,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Length","value":"3688"},{"name":"Content-Type","value":"application/javascript; charset=utf-8"},{"name":"Date","value":"Mon, 26 Oct 2026 09:02:21 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":3688,"mimeType":"application/javascript; charset=utf-8","compression":0,"text":"/* SHA-256 core for the emulated in-browser miner (FIPS 180-4).\n   Synchronous and self-contained on purpose: the worker thread must be fully\n   CPU bound, which is the behaviour under study. */\n\nconst K = new Uint32Array([\n  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,\n  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,\n  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2\n]);\n\nconst H0 = [\n  0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,\n  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19\n];\n\nconst W = new Uint32Array(64);\nconst DIGEST = new Uint32Array(8);\nconst PAD = new Uint8Array(64);\n\nfunction rotr(x, n) {\n  return ((x >>> n) | (x << (32 - n))) >>> 0;\n}\n\nfunction compress(state, block, offset) {\n  for (let i = 0; i < 16; i++) {\n    const j = offset + i * 4;\n    W[i] = ((block[j] << 24) | (block[j + 1] << 16) | (block[j + 2] << 8) | block[j + 3]) >>> 0;\n  }\n  for (let i = 16; i < 64; i++) {\n    const w15 = W[i - 15], w2 = W[i - 2];\n    const s0 = (rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >>> 3)) >>> 0;\n    const s1 = (rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >>> 10)) >>> 0;\n    W[i] = (W[i - 16] + s0 + W[i - 7] + s1) >>> 0;\n  }\n\n  let a = state[0], b = state[1], c = state[2], d = state[3];\n  let e = state[4], f = state[5], g = state[6], h = state[7];\n\n  for (let i = 0; i < 64; i++) {\n    const S1 = (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) >>> 0;\n    const ch = ((e & f) ^ ((~e) & g)) >>> 0;\n    const t1 = (h + S1 + ch + K[i] + W[i]) >>> 0;\n    const S0 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) >>> 0;\n    const maj = ((a & b) ^ (a & c) ^ (b & c)) >>> 0;\n    const t2 = (S0 + maj) >>> 0;\n    h = g; g = f; f = e;\n    e = (d + t1) >>> 0;\n    d = c; c = b; b = a;\n    a = (t1 + t2) >>> 0;\n  }\n\n  state[0] = (state[0] + a) >>> 0;\n  state[1] = (state[1] + b) >>> 0;\n  state[2] = (state[2] + c) >>> 0;\n  state[3] = (state[3] + d) >>> 0;\n  state[4] = (state[4] + e) >>> 0;\n  state[5] = (state[5] + f) >>> 0;\n  state[6] = (state[6] + g) >>> 0;\n  state[7] = (state[7] + h) >>> 0;\n}\n\n/* SHA-256 over msg (Uint8Array, <=55 bytes). Writes 8 words into `out`.\n   The padding block is reused across calls to keep allocation out of the hot loop. */\nfunction sha256Short(msg, out) {\n  const len = msg.length;\n  PAD.fill(0, 0, 64);\n  PAD.set(msg, 0);\n  PAD[len] = 0x80;\n  const view = new DataView(PAD.buffer);\n  view.setUint32(60, len * 8);\n  for (let i = 0; i < 8; i++) out[i] = H0[i];\n  compress(out, PAD, 0);\n  return out;\n}\n\nfunction sha256(msg) {\n  return sha256Short(msg, new Uint32Array(8));\n}\n\nfunction toHex(digest) {\n  let s = '';\n  for (let i = 0; i < 8; i++) s += ('00000000' + digest[i].toString(16)).slice(-8);\n  return s;\n}\n\nfunction bytesToHex(bytes) {\n  let s = '';\n  for (let i = 0; i < bytes.length; i++) s += ('0' + bytes[i].toString(16)).slice(-2);\n  return s;\n}\n\nfunction hexToBytes(hexStr) {\n  const out = new Uint8Array(hexStr.length / 2);\n  for (let i = 0; i < out.length; i++) out[i] = parseInt(hexStr.substr(i * 2, 2), 16);\n  return out;\n}\n\nself.__sha256 = { sha256, sha256Short, toHex, bytesToHex, hexToBytes, K, H0, compress };\n"},"headersSize":168,"bodySize":3688,"redirectURL":"","_transferSize":3856},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1.138,"receive":1.509},"_frameref":"frame@f9c2f6eac4ffd28695d0f432da6e7404","_monotonicTime":282400.126,"_resourceType":"other","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}}]}}