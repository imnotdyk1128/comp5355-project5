e","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/155.0.0.0 Safari/537.36 Edg/155.0.0.0"},{"name":"sec-ch-ua","value":"\"Microsoft Edge\";v=\"155\", \"Chromium\";v=\"155\", \"Not(A:Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":746,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Length","value":"226"},{"name":"Content-Type","value":"image/svg+xml; charset=utf-8"},{"name":"Date","value":"Thu, 22 Oct 2026 17:21:40 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":226,"mimeType":"image/svg+xml; charset=utf-8","compression":0,"text":"<svg xmlns='http://www.w3.org/2000/svg' width='640' height='180'><rect width='640' height='180' fill='hsl(0,40%,70%)'/><text x='20' y='100' font-size='34' font-family='sans-serif' fill='#222'>Advertisement block 0</text></svg>"},"headersSize":158,"bodySize":226,"redirectURL":"","_transferSize":384},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1.051,"receive":0.893},"_frameref":"frame@cba025b4e43f511f03b190b60479ceff","_monotonicTime":282169.432,"_resourceType":"image","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@714f262334fb8f234f11c856d086e207","startedDateTime":"2026-10-22T17:21:40.617Z","time":11.128,"request":{"method":"GET","url":"http://127.0.0.1:8080/js/miner_worker.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Referer","value":"http://127.0.0.1:8080/mining?mode=mine&threads=1&pool=ws://127.0.0.1:8777/stratum&user=mining1w1&bust=1792689700.4741411"},{"name":"Sec-Fetch-Dest","value":"worker"},{"name":"Sec-Fetch-Mode","value":"same-origin"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/155.0.0.0 Safari/537.36 Edg/155.0.0.0"}],"queryString":[],"headersSize":561,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Length","value":"2463"},{"name":"Content-Type","value":"application/javascript; charset=utf-8"},{"name":"Date","value":"Thu, 22 Oct 2026 17:21:40 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":2463,"mimeType":"application/javascript; charset=utf-8","compression":2463,"text":"/* Emulated in-browser miner: hashing worker.\n\n   Architecture follows Coinhive: the *page* (main thread) owns the pool\n   connection and the workers only burn CPU. That keeps the CPU load in worker\n   threads and makes the page's own traffic observable to an endpoint monitor\n   through the page's network stack.\n\n   The worker receives {cmd:'job', blob, difficulty} and searches nonces until\n   it finds a hash below the target, then reports the share. */\n\nimportScripts('sha256.js');\n\nconst sha = self.__sha256;\nconst out = new Uint32Array(8);\nconst msg = new Uint8Array(36);\n\nlet hashes = 0;\nlet job = null;\nlet running = false;\nlet t0 = 0;\n\nfunction targetMask(bits) {\n  return bits >= 32 ? 0 : (0xFFFFFFFF >>> bits);\n}\n\nfunction search(budgetMs) {\n  if (!job) return;\n  const end = performance.now() + budgetMs;\n  // Report a share and keep scanning: returning early would idle the thread\n  // whenever difficulty is low, which is not how a miner behaves.\n  do {\n    const mask = targetMask(job.difficulty);\n    msg.set(job.blob, 0);\n    let found = -1;\n    for (let i = 0; i < 4096; i++) {\n      const n = (job.nextNonce + i) >>> 0;\n      msg[32] = n & 255;\n      msg[33] = (n >>> 8) & 255;\n      msg[34] = (n >>> 16) & 255;\n      msg[35] = (n >>> 24) & 255;\n      sha.sha256Short(msg, out);\n      hashes++;\n      if ((out[0] & ~mask) === 0) {\n        found = n;\n        job.nextNonce = (n + 1) >>> 0;\n        break;\n      }\n    }\n    if (found < 0) {\n      job.nextNonce = (job.nextNonce + 4096) >>> 0;\n    } else {\n      self.postMessage({ cmd: 'share', jobId: job.jobId, nonce: found,\n                         hash: sha.toHex(out), diff: job.difficulty });\n    }\n  } while (performance.now() < end && job);\n}\n\nlet slice = null;\nlet reporter = null;\n\nself.onmessage = (ev) => {\n  const m = ev.data;\n  if (m.cmd === 'start') {\n    running = true;\n    t0 = performance.now();\n    slice = setInterval(() => { if (running) search(60); }, 60);\n    reporter = setInterval(() => {\n      const elapsed = (performance.now() - t0) / 1000;\n      self.postMessage({\n        cmd: 'stats',\n        hashes: hashes,\n        hashrate: elapsed > 0 ? hashes / elapsed : 0,\n        mining: !!job\n      });\n    }, 1000);\n  } else if (m.cmd === 'job') {\n    job = { jobId: m.jobId, blob: sha.hexToBytes(m.blob), difficulty: m.difficulty || 22, nextNonce: 0 };\n  } else if (m.cmd === 'stop') {\n    running = false;\n    clearInterval(slice);\n    clearInterval(reporter);\n  }\n};\n"},"headersSize":168,"bodySize":0,"redirectURL":"","_transferSize":168},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":-1,"receive":11.128},"_frameref":"frame@cba025b4e43f511f03b190b60479ceff","_monotonicTime":282186.425,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@714f262334fb8f234f11c856d086e207","startedDateTime":"2026-10-22T17:21:40.619Z","time":32998.527099609375,"request":{"method":"GET","url":"ws://127.0.0.1:8777/stratum","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Upgrade","value":"websocket"},{"name":"Ori