{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.64.0-beta-1791568591000"},"browser":{"name":"chromium","version":"155.0.4283.62"},"pages":[{"startedDateTime":"2026-10-22T17:21:40.564Z","id":"page@714f262334fb8f234f11c856d086e207","title":"Weekly report: traffic shaping on the dorm network","pageTimings":{"onContentLoad":54,"onLoad":54}}],"entries":[{"pageref":"page@714f262334fb8f234f11c856d086e207","startedDateTime":"2026-10-22T17:21:40.586Z","time":1.6019999999999999,"request":{"method":"GET","url":"http://127.0.0.1:8080/mining?mode=mine&threads=1&pool=ws://127.0.0.1:8777/stratum&user=mining1w1&bust=1792689700.4741411","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Sec-Fetch-Dest","value":"document"},{"name":"Sec-Fetch-Mode","value":"navigate"},{"name":"Sec-Fetch-Site","value":"none"},{"name":"Sec-Fetch-User","value":"?1"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/155.0.0.0 Safari/537.36 Edg/155.0.0.0"},{"name":"sec-ch-ua","value":"\"Microsoft Edge\";v=\"155\", \"Chromium\";v=\"155\", \"Not(A:Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[{"name":"mode","value":"mine"},{"name":"threads","value":"1"},{"name":"pool","value":"ws://127.0.0.1:8777/stratum"},{"name":"user","value":"mining1w1"},{"name":"bust","value":"1792689700.4741411"}],"headersSize":724,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Length","value":"577"},{"name":"Content-Type","value":"text/html; charset=utf-8"},{"name":"Date","value":"Thu, 22 Oct 2026 17:21:40 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":577,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Weekly report: traffic shaping on the dorm network</title>\n<link rel=\"stylesheet\" href=\"/css/site.css\">\n</head>\n<body>\n<header><a href=\"/\">Student Computing Group</a> &middot; <span>network</span></header>\n<main id=\"content\"></main>\n<footer>&copy; student computing group</footer>\n<script src=\"/js/page_common.js\"></script>\n<!-- mining condition: emulated Coinhive-style in-browser miner -->\n<script src=\"/js/miner_loader.js\" data-mode=\"mine\" data-threads=\"2\" data-difficulty=\"22\"></script>\n</body>\n</html>\n"},"headersSize":154,"bodySize":577,"redirectURL":"","_transferSize":731},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":0.847,"receive":0.755},"_frameref":"frame@cba025b4e43f511f03b190b60479ceff","_monotonicTime":282155.743,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@714f262334fb8f234f11c856d086e207","startedDateTime":"2026-10-22T17:21:40.592Z","time":4.086,"request":{"method":"GET","url":"http://127.0.0.1:8080/css/site.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Referer","value":"http://127.0.0.1:8080/mining?mode=mine&threads=1&pool=ws://127.0.0.1:8777/stratum&user=mining1w1&bust=1792689700.4741411"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/155.0.0.0 Safari/537.36 Edg/155.0.0.0"},{"name":"sec-ch-ua","value":"\"Microsoft Edge\";v=\"155\", \"Chromium\";v=\"155\", \"Not(A:Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":697,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Length","value":"694"},{"name":"Content-Type","value":"text/css; charset=utf-8"},{"name":"Date","value":"Thu, 22 Oct 2026 17:21:40 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":694,"mimeType":"text/css; charset=utf-8","compression":0,"text":"body { font-family: Georgia, serif; margin: 0; background: #f6f5f2; color: #1c1c1c; }\nheader { padding: 14px 24px; background: #232323; color: #fff; }\nheader a { color: #fff; text-decoration: none; }\nmain { max-width: 760px; margin: 24px auto; background: #fff; padding: 24px 32px; }\nh1 { font-size: 26px; }\n.byline { color: #777; font-size: 13px; }\nfigure { margin: 18px 0; }\nfigcaption { font-size: 12px; color: #666; }\n.widget { padding: 12px; background: #eef; border: 1px dashed #99a; font-size: 13px; }\n.comments { margin-top: 24px; }\n.comment { padding: 8px 0; border-bottom: 1px solid #eee; font-size: 14px; }\nfooter { padding: 20px; text-align: center; color: #888; font-size: 12px; }\n"},"headersSize":153,"bodySize":694,"redirectURL":"","_transferSize":847},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1.042,"receive":3.044},"_frameref":"frame@cba025b4e43f511f03b190b60479ceff","_monotonicTime":282167.328,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@714f262334fb8f234f11c856d086e207","startedDateTime":"2026-10-22T17:21:40.592Z","time":6.321,"request":{"method":"GET","url":"http://127.0.0.1:8080/js/page_common.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Referer","value":"http://127.0.0.1:8080/mining?mode=mine&threads=1&pool=ws://127.0.0.1:8777/stratum&user=mining1w1&bust=1792689700.4741411"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/155.0.0.0 Safari/537.36 Edg/155.0.0.0"},{"name":"sec-ch-ua","value":"\"Microsoft Edge\";v=\"155\", \"Chromium\";v=\"155\", \"Not(A:Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":688,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Length","value":"1823"},{"name":"Content-Type","value":"application/javascript; charset=utf-8"},{"name":"Date","value":"Thu, 22 Oct 2026 17:21:40 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":1823,"mimeType":"application/javascript; charset=utf-8","compression":0,"text":"/* Identical page furniture for every experimental condition: same DOM size,\n   same images, same timers, so only the script under test differs. */\n\n(function () {\n  const root = document.getElementById('content');\n  const paragraphs = 14;\n  const lorem = 'Campus network traffic shows the same diurnal pattern every week, and the measurement notes collected for this course describe how a shared link becomes a bottleneck shortly after midnight. ';\n  let html = '<h1>Weekly report: traffic shaping on the dorm network</h1>';\n  html += '<p class=\"byline\">Published by the student computing group &middot; read time 6 min</p>';\n\n  for (let i = 0; i < paragraphs; i++) {\n    html += '<p>' + lorem.repeat(3) + '</p>';\n    if (i === 4 || i === 9) {\n      html += '<figure><img src=\"/img/banner' + (i % 3) + '.svg\" width=\"640\" height=\"180\" alt=\"banner\">' +\n              '<figcaption>Figure ' + (i / 5 | 0) + ': throughput sample</figcaption></figure>';\n    }\n    html += '<ul><li>queue discipline: HTB with three classes</li><li>peak measured at 23:41</li>' +\n            '<li>drop tail probability tuned to 0.02</li></ul>';\n  }\n\n  html += '<div class=\"widget\" id=\"rotator\"></div>';\n  html += '<div class=\"comments\">';\n  for (let i = 0; i < 25; i++) {\n    html += '<div class=\"comment\"><b>user' + i + '</b><span> ' + lorem.slice(0, 120) + '</span></div>';\n  }\n  html += '</div>';\n  root.innerHTML = html;\n\n  const widget = document.getElementById('rotator');\n  const items = ['Sponsored: hostel deal', 'Sponsored: VPN plan', 'Sponsored: course bundle'];\n  let idx = 0;\n  setInterval(() => {\n    widget.textContent = items[idx % items.length];\n    idx++;\n  }, 2000);\n\n  let acc = 0;\n  setInterval(() => {\n    for (let i = 0; i < 20000; i++) acc += Math.sqrt(i % 997);\n    widget.dataset.tick = String(acc | 0);\n  }, 500);\n})();\n"},"headersSize":168,"bodySize":1823,"redirectURL":"","_transferSize":1991},"cache":{},"timings":{"dns":0.009,"connect":0.698,"ssl":1.769,"send":0,"wait":0.653,"receive":3.192},"_frameref":"frame@cba025b4e43f511f03b190b60479ceff","_monotonicTime":282167.432,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@714f262334fb8f234f11c856d086e207","startedDateTime":"2026-10-22T17:21:40.592Z","time":4.708,"request":{"method":"GET","url":"http://127.0.0.1:8080/js/miner_loader.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Referer","value":"http://127.0.0.1:8080/mining?mode=mine&threads=1&pool=ws://127.0.0.1:8777/stratum&user=mining1w1&bust=1792689700.4741411"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/155.0.0.0 Safari/537.36 Edg/155.0.0.0"},{"name":"sec-ch-ua","value":"\"Microsoft Edge\";v=\"155\", \"Chromium\";v=\"155\", \"Not(A:Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":689,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Length","value":"4964"},{"name":"Content-Type","value":"application/javascript; charset=utf-8"},{"name":"Date","value":"Thu, 22 Oct 2026 17:21:40 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":4964,"mimeType":"application/javascript; charset=utf-8","compression":0,"text":"/* Loader running on the page's main thread - the part a site operator embeds.\r\n\r\n   Owns the pool WebSocket (as Coinhive's loader did), distributes jobs to the\r\n   workers, submits their shares and aggregates statistics. Keeping the socket\r\n   on the page's own network stack is also what makes the traffic attributable\r\n   to the page by an endpoint monitor.\r\n\r\n   data-* attributes or the query string select the experimental condition:\r\n     <script src=\"/js/miner_loader.js\" data-mode=\"mine\" data-threads=\"2\"></script>\r\n     /mining?mode=busy&threads=2   -> identical CPU load, no pool connection\r\n*/\r\n\r\n(function () {\r\n  const scripts = document.getElementsByTagName('script');\r\n  let el = document.currentScript;\r\n  if (!el) for (const s of scripts) if (s.src.indexOf('miner_loader') >= 0) el = s;\r\n  const q = el ? el.dataset : {};\r\n  const url = new URLSearchParams(location.search);\r\n\r\n  const cfg = {\r\n    mode: url.get('mode') || q.mode || 'mine',\r\n    threads: parseInt(url.get('threads') || q.threads || '1', 10),\r\n    difficulty: parseInt(url.get('difficulty') || q.difficulty || '22', 10),\r\n    poolUrl: url.get('pool') || q.pool || 'ws://127.0.0.1:8777/stratum',\r\n    wallet: url.get('wallet') || q.wallet || '48edFrgLabWalletLabWalletLabWalletLabWalletLabWalletLab0',\r\n    user: url.get('user') || q.user || 'labvisitor'\r\n  };\r\n\r\n  const workers = [];\r\n  const agg = [];\r\n  let ws = null;\r\n  let reconnects = 0;\r\n  let bytesSent = 0, bytesReceived = 0, shares = 0, accepted = 0;\r\n  let difficulty = cfg.difficulty;\r\n  let currentJob = { jobId: 0, blob: randomHex(32), difficulty: difficulty };\r\n\r\n  function randomHex(nbytes) {\r\n    const b = new Uint8Array(nbytes);\r\n    crypto.getRandomValues(b);\r\n    return Array.from(b, x => ('0' + x.toString(16)).slice(-2)).join('');\r\n  }\r\n\r\n  function totals() {\r\n    const t = { hashes: 0, hashrate: 0, shares: shares, accepted: accepted,\r\n                reconnects: reconnects, bytesSent: bytesSent, bytesReceived: bytesReceived,\r\n                difficulty: difficulty };\r\n    for (const a of agg) { t.hashes += a.hashes || 0; t.hashrate += a.hashrate || 0; }\r\n    return t;\r\n  }\r\n\r\n  window.__lab = {\r\n    config: cfg,\r\n    stats: () => Object.assign(totals(), {\r\n      threads: cfg.threads,\r\n      running: workers.length > 0,\r\n      poolConnected: !!(ws && ws.readyState === 1),\r\n      hardwareConcurrency: navigator.hardwareConcurrency || 1\r\n    }),\r\n    stop: () => {\r\n      for (const w of workers) { w.postMessage({ cmd: 'stop' }); w.terminate(); }\r\n      workers.length = 0;\r\n      agg.length = 0;\r\n      try { ws && ws.close(); } catch (e) {}\r\n      ws = null;\r\n    }\r\n  };\r\n  window.__minerStats = () => window.__lab.stats();\r\n\r\n  function broadcastJob(job) {\r\n    currentJob = job;\r\n    if (job.difficulty) difficulty = job.difficulty;\r\n    for (const w of workers) {\r\n      w.postMessage({ cmd: 'job', jobId: job.jobId, blob: job.blob, difficulty: difficulty });\r\n    }\r\n  }\r\n\r\n  function send(msg) {\r\n    const text = JSON.stringify(msg);\r\n    if (ws && ws.readyState === 1) {\r\n      ws.send(text);\r\n      bytesSent += text.length;\r\n    }\r\n  }\r\n\r\n  function connect() {\r\n    ws = new WebSocket(cfg.poolUrl);\r\n    ws.onopen = () => send({ type: 'auth', login: cfg.wallet + '.' + cfg.user,\r\n                             agent: 'lab-inbrowser-miner/1.0', algo: 'sha256-lab' });\r\n    ws.onmessage = (ev) => {\r\n      bytesReceived += (ev.data && ev.data.length) || 0;\r\n      let m;\r\n      try { m = JSON.parse(ev.data); } catch (e) { return; }\r\n      if (m.type === 'job' || m.type === 'set_job') {\r\n        broadcastJob({ jobId: m.jobId, blob: m.blob, difficulty: m.difficulty });\r\n      } else if (m.type === 'set_diff') {\r\n        broadcastJob({ jobId: currentJob.jobId, blob: currentJob.blob, difficulty: m.difficulty });\r\n      } else if (m.type === 'ack' && m.ok) {\r\n        accepted++;\r\n      }\r\n    };\r\n    ws.onclose = () => {\r\n      if (!workers.length) return;\r\n      reconnects++;\r\n      setTimeout(connect, 1500);\r\n    };\r\n    ws.onerror = () => { try { ws.close(); } catch (e) {} };\r\n  }\r\n\r\n  for (let i = 0; i < cfg.threads; i++) {\r\n    const w = new Worker(cfg.mode === 'busy' ? '/js/busy_worker.js' : '/js/miner_worker.js');\r\n    const slot = { hashes: 0, hashrate: 0 };\r\n    agg.push(slot);\r\n    w.onmessage = (ev) => {\r\n      const m = ev.data;\r\n      if (m.cmd === 'stats') Object.assign(slot, { hashes: m.hashes, hashrate: m.hashrate });\r\n      else if (m.cmd === 'share') {\r\n        shares++;\r\n        send({ type: 'share', jobId: m.jobId, nonce: m.nonce, hash: m.hash, diff: m.diff,\r\n               hashrate: Math.round(totals().hashrate) });\r\n      }\r\n    };\r\n    w.postMessage({ cmd: 'start', workerName: cfg.user + '_' + i });\r\n    workers.push(w);\r\n  }\r\n\r\n  if (cfg.mode === 'busy') {\r\n    // identical work loop, no socket at all: the matched-CPU control\r\n    broadcastJob({ jobId: 1, blob: randomHex(32), difficulty: 0 });\r\n  } else {\r\n    connect();\r\n  }\r\n})();\r\n"},"headersSize":168,"bodySize":4964,"redirectURL":"","_transferSize":5132},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1.097,"receive":3.611},"_frameref":"frame@cba025b4e43f511f03b190b60479ceff","_monotonicTime":282167.453,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@714f262334fb8f234f11c856d086e207","startedDateTime":"2026-10-22T17:21:40.599Z","time":1.47,"request":{"method":"GET","url":"http://127.0.0.1:8080/img/banner1.svg","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Referer","value":"http://127.0.0.1:8080/mining?mode=mine&threads=1&pool=ws://127.0.0.1:8777/stratum&user=mining1w1&bust=1792689700.4741411"},{"name":"Sec-Fetch-Dest","value":"image"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/155.0.0.0 Safari/537.36 Edg/155.0.0.0"},{"name":"sec-ch-ua","value":"\