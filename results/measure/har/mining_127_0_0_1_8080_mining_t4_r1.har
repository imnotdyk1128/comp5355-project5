 an endpoint monitor\n   through the page's network stack.\n\n   The worker receives {cmd:'job', blob, difficulty} and searches nonces until\n   it finds a hash below the target, then reports the share. */\n\nimportScripts('sha256.js');\n\nconst sha = self.__sha256;\nconst out = new Uint32Array(8);\nconst msg = new Uint8Array(36);\n\nlet hashes = 0;\nlet job = null;\nlet running = false;\nlet t0 = 0;\n\nfunction targetMask(bits) {\n  return bits >= 32 ? 0 : (0xFFFFFFFF >>> bits);\n}\n\nfunction search(budgetMs) {\n  if (!job) return;\n  const end = performance.now() + budgetMs;\n  // Report a share and keep scanning: returning early would idle the thread\n  // whenever difficulty is low, which is not how a miner behaves.\n  do {\n    const mask = targetMask(job.difficulty);\n    msg.set(job.blob, 0);\n    let found = -1;\n    for (let i = 0; i < 4096; i++) {\n      const n = (job.nextNonce + i) >>> 0;\n      msg[32] = n & 255;\n      msg[33] = (n >>> 8) & 255;\n      msg[34] = (n >>> 16) & 255;\n      msg[35] = (n >>> 24) & 255;\n      sha.sha256Short(msg, out);\n      hashes++;\n      if ((out[0] & ~mask) === 0) {\n        found = n;\n        job.nextNonce = (n + 1) >>> 0;\n        break;\n      }\n    }\n    if (found < 0) {\n      job.nextNonce = (job.nextNonce + 4096) >>> 0;\n    } else {\n      self.postMessage({ cmd: 'share', jobId: job.jobId, nonce: found,\n                         hash: sha.toHex(out), diff: job.difficulty });\n    }\n  } while (performance.now() < end && job);\n}\n\nlet slice = null;\nlet reporter = null;\n\nself.onmessage = (ev) => {\n  const m = ev.data;\n  if (m.cmd === 'start') {\n    running = true;\n    t0 = performance.now();\n    slice = setInterval(() => { if (running) search(60); }, 60);\n    reporter = setInterval(() => {\n      const elapsed = (performance.now() - t0) / 1000;\n      self.postMessage({\n        cmd: 'stats',\n        hashes: hashes,\n        hashrate: elapsed > 0 ? hashes / elapsed : 0,\n        mining: !!job\n      });\n    }, 1000);\n  } else if (m.cmd === 'job') {\n    job = { jobId: m.jobId, blob: sha.hexToBytes(m.blob), difficulty: m.difficulty || 22, nextNonce: 0 };\n  } else if (m.cmd === 'stop') {\n    running = false;\n    clearInterval(slice);\n    clearInterval(reporter);\n  }\n};\n"},"headersSize":168,"bodySize":0,"redirectURL":"","_transferSize":168},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":-1,"receive":5014.402},"_frameref":"frame@1f9d9016d6f2749343b34280d6a442ec","_monotonicTime":430579.133,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@5c0175f8f3dcc865d7a2e623e0fcd1b3","startedDateTime":"2026-10-26T09:04:49.995Z","time":34798.890869140625,"request":{"method":"GET","url":"ws://127.0.0.1:8777/stratum","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Upgrade","value":"websocket"},{"name":"Origin","value":"http://127.0.0.1:8080"},{"name":"Cache-Control","value":"no-cache"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Pragma","value":"no-cache"},{"name":"Connection","value":"Upgrade"},{"name":"Sec-WebSocket-Key","value":"wn84IXyRNsaF45Y2LNp2Ag=="},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.0.0 Safari/537.36 Edg/156.0.0.0"},{"name":"Sec-WebSocket-Version","value":"13"},{"name":"Host","value":"127.0.0.1:8777"},{"name":"Sec-WebSocket-Extensions","value":"permessage-deflate; client_max_window_bits"}],"queryString":[],"headersSize":557,"bodySize":-1},"response":{"status":101,"statusText":"Switching Protocols","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Upgrade","value":"websocket"},{"name":"Date","value":"Mon, 26 Oct 2026 09:04:49 GMT"},{"name":"Sec-WebSocket-Accept","value":"x5JCsTpObO/Me4hJsMKR9mv/LHc="},{"name":"Connection","value":"upgrade"},{"name":"Se