= n & 255;\n      msg[33] = (n >>> 8) & 255;\n      msg[34] = (n >>> 16) & 255;\n      msg[35] = (n >>> 24) & 255;\n      sha.sha256Short(msg, out);\n      hashes++;\n      if ((out[0] & ~mask) === 0) {\n        found = n;\n        job.nextNonce = (n + 1) >>> 0;\n        break;\n      }\n    }\n    if (found < 0) {\n      job.nextNonce = (job.nextNonce + 4096) >>> 0;\n    } else {\n      self.postMessage({ cmd: 'share', jobId: job.jobId, nonce: found,\n                         hash: sha.toHex(out), diff: job.difficulty });\n    }\n  } while (performance.now() < end && job);\n}\n\nlet slice = null;\nlet reporter = null;\n\nself.onmessage = (ev) => {\n  const m = ev.data;\n  if (m.cmd === 'start') {\n    running = true;\n    t0 = performance.now();\n    slice = setInterval(() => { if (running) search(60); }, 60);\n    reporter = setInterval(() => {\n      const elapsed = (performance.now() - t0) / 1000;\n      self.postMessage({\n        cmd: 'stats',\n        hashes: hashes,\n        hashrate: elapsed > 0 ? hashes / elapsed : 0,\n        mining: !!job\n      });\n    }, 1000);\n  } else if (m.cmd === 'job') {\n    job = { jobId: m.jobId, blob: sha.hexToBytes(m.blob), difficulty: m.difficulty || 22, nextNonce: 0 };\n  } else if (m.cmd === 'stop') {\n    running = false;\n    clearInterval(slice);\n    clearInterval(reporter);\n  }\n};\n"},"headersSize":168,"bodySize":0,"redirectURL":"","_transferSize":168},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":-1,"receive":5016.665},"_frameref":"frame@1f9d9016d6f2749343b34280d6a442ec","_monotonicTime":430575.084,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@5c0175f8f3dcc865d7a2e623e0fcd1b3","startedDateTime":"2026-10-26T09:04:49.989Z","time":5016.656,"request":{"method":"GET","url":"http://127.0.0.1:8080/js/miner_worker.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":