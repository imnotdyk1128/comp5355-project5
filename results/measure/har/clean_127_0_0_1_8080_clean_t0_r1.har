; charset=utf-8"},{"name":"Date","value":"Mon, 26 Oct 2026 08:57:40 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":478,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Weekly report: traffic shaping on the dorm network</title>\n<link rel=\"stylesheet\" href=\"/css/site.css\">\n</head>\n<body>\n<header><a href=\"/\">Student Computing Group</a> &middot; <span>network</span></header>\n<main id=\"content\"></main>\n<footer>&copy; student computing group</footer>\n<!-- control condition: page furniture only, no worker, no pool -->\n<script src=\"/js/page_common.js\"></script>\n</body>\n</html>\n"},"headersSize":154,"bodySize":478,"redirectURL":"","_transferSize":632},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":9.237,"receive":1.576},"_frameref":"frame@d25164eee21eb3a88879b5f97479872c","_monotonicTime":719.092,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@87acfaea9954bf6e0428694a9f7b9504","startedDateTime":"2026-10-26T08:57:40.146Z","time":5.992,"request":{"method":"GET","url":"http://127.0.0.1:8080/css/site.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Referer","value":"http://127.0.0.1:8080/clean?pool=ws://127.0.0.1:8777/stratum&user=clean0w1&bust=1793005059.9704692"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.0.0 Safari/537.36 Edg/156.0.0.0"},{"name":"sec-ch-ua","value":"\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\", \"Microsoft Edge\";v=\"156\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":674,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Length","value":"694"},{"name":"Content-Type","value":"text/css; charset=utf-8"},{"name":"Date","value":"Mon, 26 Oct 2026 08:57:40 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":694,"mimeType":"text/css; charset=utf-8","compression":0,"text":"body { font-family: Georgia, serif; margin: 0; background: #f6f5f2; color: #1c1c1c; }\nheader { padding: 14px 24px; background: #232323; color: #fff; }\nheader a { color: #fff; text-decoration: none; }\nmain { max-width: 760px; margin: 24px auto; background: #fff; padding: 24px 32px; }\nh1 { font-size: 26px; }\n.byline { color: #777; font-size: 13px; }\nfigure { margin: 18px 0; }\nfigcaption { font-size: 12px; color: #666; }\n.widget { padding: 12px; background: #eef; border: 1px dashed #99a; font-size: 13px; }\n.comments { margin-top: 24px; }\n.comment { padding: 8px 0; border-bottom: 1px solid #eee; font-size: 14px; }\nfooter { padding: 20px; text-align: center; color: #888; font-size: 12px; }\n"},"headersSize":153,"bodySize":694,"redirectURL":"","_transferSize":847},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1.151,"receive":4.841},"_frameref":"frame@d25164eee21eb3a88879b5f97479872c","_monotonicTime":743.374,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@87acfaea9954bf6e0428694a9f7b9504","startedDateTime":"2026-10-26T08:57:40.146Z","time":8.82,"request":{"method":"GET","url":"http://127.0.0.1:8080/js/page_common.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8080"},{"name":"Referer","value":"http://127.0.0.1:8080/clean?pool=ws://127.0.0.1:8777/stratum&user=clean0w1&bust=1793005059.9704692"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.0.0 Safari/537.36 Edg/156.0.0.0"},{"name":"sec-ch-ua","value":"\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\", \"Microsoft Edge\";v=\"156\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":665,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Length","value":"1823"},{"name":"Content-Type","value":"application/javascript; charset=utf-8"},{"name":"Date","value":"Mon, 26 Oct 2026 08:57:40 GMT"},{"name":"Server","value":"Python/3.12 aiohttp/3.11.11"}],"content":{"size":1823,"mimeType":"application/javascript; charset=utf-8","compression":0,"text":"/* Identical page furniture for every experimental condition: same DOM size,\n   same images, same timers, so only the script under test differs. */\n\n(function () {\n  const root = document.getElementById('content');\n  const paragraphs = 14;\n  const lorem = 'Campus network traffic shows the same diurnal pattern every week, and the measurement notes collected for this course describe how a shared link becomes a bottleneck shortly after midnight. ';\n  let html = '<h1>Weekly report: traffic shaping on the dorm network</h1>';\n  html += '<p class=\"byline\">Published by the student computing group &middot; read time 6 min</p>';\n\n  for (let i = 0; i < paragraphs; i++) {\n    html += '<p>' + lorem.repeat(3) + '</p>';\n    if (i === 4 || i === 9) {\n      html += '<figure><img src=\"/img/banner' + (i % 3) + '.svg\" width=\"640\" height=\"180\" alt=\"banner\">' +\n              '<figcaption>Figure ' + (i / 5 | 0) + ': throughput sample</figcaption></figure>';\n    }\n    html += '<ul><li>queue discipline: HTB with three classes</li><li>peak measured at 23:41</li>' +\n            '<li>drop tail probability tuned to 0.02</li></ul>';\n  }\n\n  html += '<div class=\"widget\" id=\"rotator\"></div>';\n  html += '<div class=\"comments\">';\n  for (let i = 0; i < 25; i++) {\n    html += '<div class=\"comment\"><b>user' + i + '</b><span> ' + lorem.slice(0, 120) + '</span></div>';\n  }\n  html += '</div>';\n  root.innerHTML = html;\n\n  const widget = document.getElementById('rotator');\n  const items = ['Sponsored: hostel deal', 'Sponsored: VPN plan', 'Sponsored: course bundle'];\n  let idx = 0;\n  setInterval(() => {\n    widget.textContent = items[idx % items.length];\n    idx++;\n  }, 2000);\n\n  let acc = 0;\n  setInterval(() => {\n    for (let i = 0; i < 20000; i++) acc += Math.sqrt(i % 997);\n    widget.dataset.tick = String(acc | 0);\n  }, 500);\n})();\n"},"headersSize":168,"bodySize":1823,"redirectURL":"","_transferSize":1991},"cache":{},"timings":{"dns":0.01,"connect":0.407,"ssl":1.501,"send":0,"wait":1.854,"receive":5.048},"_frameref":"frame@d25164eee21eb3a88879b5f97479872c","_monotonicTime":743.518,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8080,"_securityDetails":{}},{"pageref":"page@87acfaea9954bf6e0428694a9f7b9504","startedDateTime":"2026-10-26T08:57:40.158Z","time":1.4260000000000002,"request":{"method":"GET","url":"http://127.0.0.1:8080/img/banner1.svg","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"},{"name":